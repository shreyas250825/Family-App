PORT=5000
NODE_ENV=development

# Supabase — create project at https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS — comma-separated origins (use * only for local dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,exp://

# Optional: public URL for uploaded media (defaults to relative /uploads)
PUBLIC_API_URL=http://localhost:5000

# Rate limiting
AUTH_RATE_LIMIT_MAX=10
